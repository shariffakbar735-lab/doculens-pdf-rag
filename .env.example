# ─────────────────────────────────────────────────────────────────────────────
# RagKit Simple – environment variable reference
#
# Copy this file to .env and adjust as needed.
# Docker Compose reads .env automatically.
# ─────────────────────────────────────────────────────────────────────────────

# ── Ollama ────────────────────────────────────────────────────────────────
# When running locally (not in Docker), point to the local Ollama instance.
# When running in Docker Compose, leave this unset; compose.yaml sets it to
# http://ollama:11434 automatically.
# OLLAMA_HOST=http://localhost:11434

# Answer-generation model (must be pulled in Ollama first)
LLM_MODEL=qwen3:4b

# Embedding model (must be pulled in Ollama first)
EMBED_MODEL=nomic-embed-text

# ── Chunking ──────────────────────────────────────────────────────────────
# Characters per chunk
CHUNK_SIZE=800

# Characters of overlap between consecutive chunks
CHUNK_OVERLAP=100

# ── Retrieval ─────────────────────────────────────────────────────────────
# Number of chunks to retrieve per question
RETRIEVAL_TOP_K=4

# ── Upload ────────────────────────────────────────────────────────────────
# Maximum PDF upload size in megabytes
MAX_UPLOAD_MB=50
